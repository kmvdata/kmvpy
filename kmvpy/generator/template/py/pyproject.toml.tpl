[build-system]
requires = ["setuptools>=77.0.3"]
build-backend = "setuptools.build_meta"

[project]
name = "__PROJECT_NAME__"
version = "0.0.1"
description = "__PROJECT_NAME__ generated by kmvpy"
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "kmvpy[mysql]>=0.2.3,<0.3",
]

[project.optional-dependencies]
test = [
    "kmvpy[test]>=0.2.3,<0.3",
]

[tool.setuptools]
packages = {find = {where = ["."], exclude = ["app", "app.*"]}}
include-package-data = true
zip-safe = false
